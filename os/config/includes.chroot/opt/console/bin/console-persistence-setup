#!/bin/bash
# Primeiro uso do pendrive: cria uma partição "persistence" no espaço livre
# depois da imagem, para guardar saves, configurações, Wi-Fi e jogos novos.
# Só mexe no próprio pendrive de onde o sistema iniciou, e só em espaço vazio.
set -u
export LC_ALL=C

say() {
    echo "console-persistence: $*"
    [ -n "${CONSOLE_TEST_MEDIUM:-}" ] || printf '\n  %s\n' "$*" > /dev/tty1 2>/dev/null || true
}

# Variáveis CONSOLE_TEST_* existem só para testar o script fora do pendrive.
cmdline=" ${CONSOLE_TEST_CMDLINE:-$(cat /proc/cmdline)} "
case "$cmdline" in *" console.persistence=off "*) exit 0 ;; esac

# Já existe (ou já está em uso)?
if blkid -L persistence >/dev/null 2>&1; then
    exit 0
fi

medium=${CONSOLE_TEST_MEDIUM:-$(findmnt -no SOURCE /run/live/medium 2>/dev/null | head -n1)}
if [ -z "$medium" ] || [ ! -b "$medium" ]; then
    exit 0
fi
disk_name=$(lsblk -no PKNAME "$medium" 2>/dev/null | head -n1)
if [ -z "$disk_name" ]; then
    say "Mídia sem partições (gravada em modo ISO?). Saves não serão guardados."
    exit 0
fi
disk="/dev/$disk_name"

tran=$(lsblk -dno TRAN "$disk" 2>/dev/null | tr -d ' ')
removable=$(lsblk -dno RM "$disk" 2>/dev/null | tr -d ' ')
case "$cmdline" in *" console.persistence=force "*) tran=usb ;; esac
if [ "$tran" != "usb" ] && [ "$removable" != "1" ]; then
    say "O sistema não iniciou de um pendrive; o disco não será alterado."
    exit 0
fi

label=$(sfdisk -d "$disk" 2>/dev/null | sed -n 's/^label: //p')
if [ "$label" != "dos" ]; then
    say "Tabela de partições '$label' não suportada; saves não serão guardados."
    exit 0
fi
count=$(sfdisk -d "$disk" 2>/dev/null | grep -c '^/dev/')
if [ "$count" -ge 4 ]; then
    say "Sem espaço na tabela de partições; saves não serão guardados."
    exit 0
fi

# Maior região livre (em setores de 512 bytes); precisa de pelo menos 1 GiB.
read -r free_start free_sectors < <(sfdisk -F "$disk" 2>/dev/null |
    awk '$1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {print $1, $3}' |
    sort -k2 -n | tail -n1)
if [ -z "${free_start:-}" ] || [ "${free_sectors:-0}" -lt 2097152 ]; then
    say "Pouco espaço livre no pendrive; saves não serão guardados."
    exit 0
fi

say "Primeiro uso: preparando a área de saves no pendrive (cerca de 1 minuto)..."
before=$(sfdisk -d "$disk" | grep '^/dev/' | awk '{print $1}')

# Mesmo procedimento do guia do Debian (fdisk: nova partição primária no fim).
# Com 3 partições o fdisk não pergunta o número; por isso a entrada muda.
if [ "$count" -le 2 ]; then
    fdisk_input=$(printf 'n\np\n\n%s\n\nw\n' "$free_start")
else
    fdisk_input=$(printf 'n\np\n%s\n\nw\n' "$free_start")
fi
echo "$fdisk_input" | fdisk -W always "$disk" >/tmp/console-fdisk.log 2>&1

after=$(sfdisk -d "$disk" | grep '^/dev/' | awk '{print $1}')
part=$(comm -13 <(echo "$before" | sort) <(echo "$after" | sort) | head -n1)
if [ -z "$part" ]; then
    say "Não foi possível criar a partição (veja /tmp/console-fdisk.log)."
    exit 0
fi
nr=$(echo "$part" | grep -o '[0-9]*$')
partx --add --nr "$nr" "$disk" 2>/dev/null || partx --update --nr "$nr" "$disk" 2>/dev/null || true
udevadm settle 2>/dev/null || sleep 2

if ! mkfs.ext4 -q -F -L persistence "$part"; then
    say "Falha ao formatar $part."
    exit 0
fi
mnt=$(mktemp -d)
if mount "$part" "$mnt"; then
    echo "/ union" > "$mnt/persistence.conf"
    sync
    umount "$mnt"
fi
rmdir "$mnt"

say "Pronto! O console vai reiniciar e, daqui em diante, os saves ficam guardados."
sleep 4
[ -n "${CONSOLE_TEST_NOREBOOT:-}" ] || systemctl reboot
